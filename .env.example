# RIFTWIRE configuration. Copy to .env (scripts/bootstrap.sh does this if .env is missing).
# Every value is optional; the defaults below are what the app uses without a .env file.
# No secrets are needed in Phase 1.

# development | test | production
RIFTWIRE_ENV=development

# API binds to localhost only. Do not expose RIFTWIRE publicly.
RIFTWIRE_API_HOST=127.0.0.1
RIFTWIRE_API_PORT=8000

# Where recordings, thumbnails, temp files, logs and the database live.
# Relative paths are resolved from the repository root. To move data to an external
# APFS SSD later, point this at it, e.g. /Volumes/RiftSSD/riftwire-data
RIFTWIRE_DATA_DIR=data
# Optional explicit database file (defaults to $RIFTWIRE_DATA_DIR/riftwire.db)
# RIFTWIRE_DATABASE_PATH=

# Upload limits. 53687091200 = 50 GiB per file.
RIFTWIRE_MAX_UPLOAD_BYTES=53687091200
# Always keep this much free on the data volume. 64424509440 = 60 GiB (owner requirement).
RIFTWIRE_MIN_FREE_DISK_BYTES=64424509440

# Background worker: one heavy job at a time by default.
RIFTWIRE_WORKER_CONCURRENCY=1
RIFTWIRE_JOB_MAX_ATTEMPTS=3
RIFTWIRE_JOB_LEASE_SECONDS=60
RIFTWIRE_JOB_BACKOFF_BASE_SECONDS=5
RIFTWIRE_JOB_BACKOFF_MAX_SECONDS=600
RIFTWIRE_WORKER_SHUTDOWN_GRACE_SECONDS=30

# DEBUG | INFO | WARNING | ERROR
RIFTWIRE_LOG_LEVEL=INFO

# Media tools (names on PATH or absolute paths). Homebrew on Apple Silicon: /opt/homebrew/bin
RIFTWIRE_FFMPEG_PATH=ffmpeg
RIFTWIRE_FFPROBE_PATH=ffprobe
RIFTWIRE_FFPROBE_TIMEOUT_SECONDS=30
RIFTWIRE_FFMPEG_TIMEOUT_SECONDS=120

# Thumbnail bounding box (aspect ratio is always preserved).
RIFTWIRE_THUMBNAIL_WIDTH=480
RIFTWIRE_THUMBNAIL_HEIGHT=270

# URL fetching (yt-dlp) is OFF by default. Public availability is never permission:
# even when on, a link is fetched only under a user-confirmed creator permission,
# ownership record or licence that allows URL fetching, with written platform permission
# attached. Real platform downloads and yt-dlp are not yet authorized for this project.
# RIFTWIRE_URL_ACQUISITION_ENABLED=false

# Optional local Short export settings. Use absolute paths to the installed Whisper
# Python and model directory, and to the vertical MP4 outro (with an audio sting, a silent
# audio track, or no audio track). The outro is never trimmed: its duration comes from
# the file. RIFTWIRE_CLIP_OUTRO_DURATION_SECONDS (e.g. 2.5) is checked against it.
# RIFTWIRE_CLIP_WHISPER_PYTHON=
# RIFTWIRE_CLIP_WHISPER_MODEL=
# RIFTWIRE_CLIP_OUTRO_PATH=
# RIFTWIRE_CLIP_OUTRO_DURATION_SECONDS=2.5
# continue = gameplay audio runs under the outro with its sting mixed beneath (PR #6);
# outro = gameplay audio ends at the cut and the outro's audio, or silence, plays.
# RIFTWIRE_CLIP_OUTRO_AUDIO=continue
# RIFTWIRE_CLIP_OUTRO_FADE_MS=500
# RIFTWIRE_CLIP_OUTRO_STING_GAIN_DB=-6
